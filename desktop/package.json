{
  "name": "Loops",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "node scripts/package.mjs",
    "test:package": "node tests/integration/check-package.mjs",
    "test:coverage": "c8 node --test tests/*.test.mjs",
    "test:ui": "electron tests/integration/loading-flows.cjs && electron tests/integration/model-connection.cjs && electron tests/integration/workflow-lifecycle.cjs"
  },
  "main": "electron/main.mjs",
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "c8": "12.0.0",
    "electron": "45.1.0",
    "vite": "8.3.5"
  },
  "license": "Apache-2.0",
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    },
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
